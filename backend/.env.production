PORT=5000
NODE_ENV=production
CLUSTER_ENABLED=true
ALLOWED_ORIGINS=https://railflow.example.com

# PostgreSQL
PGHOST=postgres
PGPORT=5432
PGUSER=railflow
PGPASSWORD=change_me_in_production
PGDATABASE=railflow

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=generate_a_strong_random_secret
JWT_REFRESH_SECRET=generate_another_strong_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP (Email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@railflow.com
SMTP_PASS=change_me
SMTP_FROM=RailFlow <noreply@railflow.com>

# SMS (Twilio)
TWILIO_ACCOUNT_SID=change_me
TWILIO_AUTH_TOKEN=change_me
TWILIO_FROM_NUMBER=+1234567890

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
