PORT=5000
NODE_ENV=development
CLUSTER_ENABLED=false
ALLOWED_ORIGINS=*

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=railflow

# Redis
REDIS_URL=redis://localhost:6379

# JWT (dev defaults)
JWT_SECRET=dev_secret_key
JWT_REFRESH_SECRET=dev_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP (MailHog in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RailFlow <noreply@railflow.com>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug
# LOG_FILE=logs/railflow.log  # Uncomment for file-based logging in production
