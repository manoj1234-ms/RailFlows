PORT=5000
NODE_ENV=development
CLUSTER_ENABLED=false
ALLOWED_ORIGINS=*

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=railflow

# Redis
REDIS_URL=redis://localhost:6379

# JWT (dev defaults)
JWT_SECRET=dev_secret_key
JWT_REFRESH_SECRET=dev_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP (Twilio SendGrid default configuration)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com


# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug
# LOG_FILE=logs/railflow.log  # Uncomment for file-based logging in production

# Google OAuth (get from Google Cloud Console > APIs & Services > Credentials)
# Must match VITE_GOOGLE_CLIENT_ID in frontend/.env
GOOGLE_CLIENT_ID=

# External Indian Railways API (RapidAPI)
# Sign up at rapidapi.com and subscribe to "Indian Railway" (e.g. irctc1.p.rapidapi.com)
RAPIDAPI_KEY=
RAPIDAPI_HOST=irctc1.p.rapidapi.com

# Razorpay Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Twilio SMS (For 2FA / Aadhaar verification)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Apache Kafka Event Streaming
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=railflow-backend

# OpenTelemetry Distributed Tracing
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SAMPLE_RATE=0.1

# MFA / TOTP Bypass Code (development only)
# When NODE_ENV !== 'production', code "123456" (or MFA_BYPASS_CODE value) will skip TOTP verification.
# ⚠️ CRITICAL: Verify NODE_ENV=production is set in production deployments.
# If NODE_ENV is left as 'development' in production, this bypass will work in production too.
MFA_BYPASS_CODE=123456

# Load Testing Override (disables rate-limiting thresholds if true)
LOAD_TEST=false


